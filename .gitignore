# 打包产物（体积大，可由源码重建）
/dist/
/build/
/.cache/
# 临时打包目录（换个名字重打包时留下的）
/dist_x/
/dist_y/
/dist_z/
/build_x/
/build_y/
/build_z/

# 本地打包虚拟环境
.venvbuild/

# 运行时数据：日志与用户配置
/logs/
config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 调试截图（排查过程的临时产物）
build_tools/*.png

# 个人版详细说明，含本机路径等信息，不随仓库发布
使用说明.md

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
